[Unit]
Description=TurboPi Update Service
Documentation=https://github.com/CteNerd/turbopi-opensource-os
After=network-online.target turbopi-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/turbopi/current
EnvironmentFile=/etc/turbopi/config.env
ExecStart=/opt/turbopi/current/bin/updater
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=turbopi
StateDirectoryMode=0750
LogsDirectory=turbopi
LogsDirectoryMode=0750
ReadWritePaths=/opt/turbopi

[Install]
WantedBy=multi-user.target

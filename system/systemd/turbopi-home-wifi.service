[Unit]
Description=TurboPi Home Wi-Fi Client
After=network-pre.target turbopi-emergency-ap.service
Before=network-online.target
Wants=network-pre.target
# Start after emergency AP to ensure recovery plane is established first
DefaultDependencies=no

[Service]
Type=forking
PIDFile=/run/wpa_supplicant-home.pid

# Environment variable to specify which interface to use (default: wlan1)
# Can be overridden via systemd override file or environment
Environment="WIFI_INTERFACE=wlan1"

# Setup the network interface
ExecStartPre=/usr/local/bin/turbopi/setup-home-wifi.sh

# Start wpa_supplicant for home Wi-Fi connection
# -B: Run in background (daemon mode)
# -P: Write PID file
# -i: Interface to use
# -c: Configuration file
# -D: Driver (nl80211 is the standard Linux wireless driver)
ExecStart=/sbin/wpa_supplicant -B -P /run/wpa_supplicant-home.pid -i ${WIFI_INTERFACE} -c /etc/turbopi/network/wpa_supplicant-home.conf -D nl80211

# Wait for wpa_supplicant to associate (wpa_state=COMPLETED) before requesting DHCP.
# Brief initial delay allows wpa_supplicant daemon to fully initialize after forking.
# Then polls up to 20 seconds (configurable via WIFI_CONNECT_TIMEOUT) for association.
ExecStartPost=/bin/sh -c '\
  sleep 2; \
  TIMEOUT="${WIFI_CONNECT_TIMEOUT:-20}"; \
  i=0; \
  for i in $(seq 1 "$TIMEOUT"); do \
    STATE=$(wpa_cli -i "${WIFI_INTERFACE}" status 2>/dev/null | grep -w "^wpa_state" | cut -d= -f2); \
    if [ "$STATE" = "COMPLETED" ]; then \
      break; \
    fi; \
    sleep 1; \
  done; \
  if [ "$STATE" = "COMPLETED" ]; then \
    logger -t turbopi-home-wifi "Wi-Fi associated after $i seconds, starting dhclient on ${WIFI_INTERFACE}"; \
  else \
    logger -t turbopi-home-wifi "WARNING: Wi-Fi not associated after $TIMEOUT seconds, running dhclient anyway"; \
  fi; \
  if ! /sbin/dhclient "${WIFI_INTERFACE}" 2>/dev/null; then \
    logger -t turbopi-home-wifi "ERROR: dhclient failed on ${WIFI_INTERFACE}"; \
  fi \
'

# Cleanup on stop
ExecStop=/bin/sh -c 'PID=$(cat /run/wpa_supplicant-home.pid 2>/dev/null) && [ -n "$PID" ] && [ "$(cat /proc/$PID/comm 2>/dev/null)" = "wpa_supplicant" ] && kill -TERM "$PID" 2>/dev/null || true'
ExecStop=/bin/sh -c '\
  if pgrep -f "dhclient.*${WIFI_INTERFACE}" >/dev/null 2>&1; then \
    if /sbin/dhclient -r "${WIFI_INTERFACE}" 2>/dev/null; then \
      :; \
    else \
      logger -t turbopi-home-wifi "Failed to release DHCP lease on ${WIFI_INTERFACE}"; \
    fi; \
  else \
    logger -t turbopi-home-wifi "No dhclient process found for ${WIFI_INTERFACE}, skipping DHCP release."; \
  fi || true \
'
ExecStopPost=/bin/rm -f /run/wpa_supplicant-home.pid

# Restart policy
Restart=on-failure
RestartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=TurboPi Wake Word Detection Service
Documentation=https://github.com/CteNerd/turbopi-opensource-os
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turbopi
Group=turbopi
WorkingDirectory=/opt/turbopi/current
EnvironmentFile=/etc/turbopi/config.env
ExecStart=/opt/turbopi/current/bin/wake-word
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/turbopi

# Resource limits (low CPU usage requirement)
CPUQuota=20%
MemoryMax=100M

[Install]
WantedBy=multi-user.target

[Unit]
Description=TurboPi API Backend
Documentation=https://github.com/CteNerd/turbopi-opensource-os
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turbopi
Group=turbopi
WorkingDirectory=/opt/turbopi/current
EnvironmentFile=/etc/turbopi/config.env
# Ensure state directory exists with correct permissions before service starts
ExecStartPre=-/bin/mkdir -p /var/lib/turbopi
ExecStartPre=/bin/chown turbopi:turbopi /var/lib/turbopi
ExecStartPre=/bin/chmod 0750 /var/lib/turbopi
ExecStart=/opt/turbopi/current/bin/api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/turbopi /var/log/turbopi /etc/turbopi/config.env
StateDirectory=turbopi
StateDirectoryMode=0750
LogsDirectory=turbopi
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target

[Unit]
Description=TurboPi API Backend
Documentation=https://github.com/CteNerd/turbopi-opensource-os
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turbopi
Group=turbopi
WorkingDirectory=/opt/turbopi/current
EnvironmentFile=/etc/turbopi/config.env
ExecStart=/opt/turbopi/current/bin/api
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=turbopi
StateDirectoryMode=0750
LogsDirectory=turbopi
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target

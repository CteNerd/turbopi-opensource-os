[Unit]
Description=TurboPi Emergency Access Point
After=network-pre.target
Before=network-online.target
Wants=network-pre.target
# Ensure we start before other network services
DefaultDependencies=no

[Service]
Type=forking
PIDFile=/run/hostapd-emergency.pid

# Setup the network interface
ExecStartPre=/usr/local/bin/turbopi/setup-emergency-ap.sh

# Start hostapd for the AP (runs in background with PID file)
ExecStart=/usr/sbin/hostapd -B -P /run/hostapd-emergency.pid /etc/turbopi/network/hostapd-emergency.conf

# Start dnsmasq for DHCP (with PID file)
ExecStartPost=/usr/sbin/dnsmasq --conf-file=/etc/turbopi/network/dnsmasq-emergency.conf --pid-file=/run/dnsmasq-emergency.pid

# Cleanup on stop - use explicit SIGTERM with timeout
ExecStop=/bin/sh -c 'test -f /run/hostapd-emergency.pid && kill -TERM $(cat /run/hostapd-emergency.pid) || true'
ExecStop=/bin/sh -c 'test -f /run/dnsmasq-emergency.pid && kill -TERM $(cat /run/dnsmasq-emergency.pid) || true'
ExecStopPost=/bin/rm -f /run/hostapd-emergency.pid /run/dnsmasq-emergency.pid

# Restart policy - will now properly detect daemon crashes
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

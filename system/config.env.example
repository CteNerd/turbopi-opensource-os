# TurboPi OpenSource OS Configuration
# This file is loaded by systemd services via EnvironmentFile directive
# Copy this to /etc/turbopi/config.env and customize for your robot

# === Robot Identity ===
ROBOT_NAME=TurboPi
WAKE_WORD=Jarvis
WAKE_WORD_ENABLED=true
WAKE_WORD_TIMEOUT=5
VERSION=0.1.17

# === Service Configuration ===
API_HOST=0.0.0.0
API_PORT=8080
API_WS_PORT=8765
UI_HOST=0.0.0.0
UI_PORT=8081
# Set true if the joystick steering direction is mirrored on the target kit.
UI_DRIVE_INVERT_STEERING=false

# === Cloud Services (Optional) ===
# These credentials are only required if using cloud-based AI features
# The robot can function without these for basic operation
# OPENAI_API_KEY=your-key-here
# TTS_PROVIDER=openai
# STT_PROVIDER=openai

# === Safety Parameters ===
MAX_LINEAR_SPEED=0.5
MAX_ANGULAR_SPEED=1.2
# Deadman timeout for stopping motion when control input goes stale.
DEADMAN_TIMEOUT_MS=500
# How long recent manual input preempts autonomous control decisions.
MANUAL_OVERRIDE_TIMEOUT_MS=500

# === HAL Calibration ===
HAL_MOTOR_BACKEND=sim
# If true with HAL_MOTOR_BACKEND=vendor, startup fails when vendor SDK is unavailable
HAL_MOTOR_VENDOR_REQUIRED=false
HAL_MOTOR_LEFT_TRIM=0.0
HAL_MOTOR_RIGHT_TRIM=0.0
HAL_MOTOR_LEFT_SCALE=1.0
HAL_MOTOR_RIGHT_SCALE=1.0
# Vendor backend motor duty ceiling (1-100)
HAL_MOTOR_MAX_DUTY=35
# Comma-separated unhealthy channels (example: 3)
HAL_MOTOR_DISABLED_CHANNELS=
# If true, non-zero commands touching disabled channels are blocked
HAL_MOTOR_BLOCK_ON_DISABLED_CHANNELS=true
# Optional per-channel scale multipliers for hardening/tuning (0.0-2.0)
HAL_MOTOR_CHANNEL_SCALE_1=1.0
HAL_MOTOR_CHANNEL_SCALE_2=1.0
HAL_MOTOR_CHANNEL_SCALE_3=1.0
HAL_MOTOR_CHANNEL_SCALE_4=1.0
HAL_HEAD_BACKEND=sim
HAL_HEAD_VENDOR_REQUIRED=false
HAL_HEAD_PAN_MIN_DEG=-70
HAL_HEAD_PAN_MAX_DEG=70
HAL_HEAD_TILT_MIN_DEG=-35
HAL_HEAD_TILT_MAX_DEG=35
HAL_HEAD_PAN_CENTER_DEG=0
HAL_HEAD_TILT_CENTER_DEG=0
HAL_HEAD_PAN_SERVO_ID=2
HAL_HEAD_TILT_SERVO_ID=1
HAL_HEAD_PAN_PULSE_MIN=1000
HAL_HEAD_PAN_PULSE_MAX=2000
HAL_HEAD_TILT_PULSE_MIN=1000
HAL_HEAD_TILT_PULSE_MAX=2000
# Optional center override; when unset, vendor servo_config.yaml is used if available.
# HAL_HEAD_PAN_PULSE_CENTER=1500
# HAL_HEAD_TILT_PULSE_CENTER=1500
HAL_HEAD_MOVE_TIME_S=0.05
HAL_CAMERA_BACKEND=auto
HAL_CAMERA_DEVICE=-1
HAL_CAMERA_WIDTH=640
HAL_CAMERA_HEIGHT=480
HAL_CAMERA_FPS=30
HAL_CAMERA_PIXEL_FORMAT=rgb24
HAL_SENSOR_DISTANCE_OFFSET_CM=0.0

# === Update Configuration ===
AUTO_UPDATE=false
AUTO_UPDATE_CHANNEL=stable
AUTO_UPDATE_SCHEDULE_UTC=03:00
DOWNLOAD_DIR=/opt/turbopi/downloads

# === Logging ===
LOG_LEVEL=INFO
